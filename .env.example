# ==============================================================================
# GeoAlert - Environment Configuration Template
# Salin file ini menjadi .env lalu sesuaikan nilai parameter di bawah ini:
# cp .env.example .env
# ==============================================================================

# 1. Aliran Data TCP GNSS (Node Tailscale / RTKLIB str2str)
TCP_IP=100.122.238.102
TCP_PORT=9000
RECONNECT_DELAY_SEC=3.0
SOCKET_TIMEOUT_SEC=10.0

# 2. Parameter Geodesi & Deteksi Deformasi
STATION_ID=GALT-BDG-01
REQUIRE_FIXED_ONLY=True
BASELINE_SAMPLE_COUNT=60
DISPLACEMENT_THRESHOLD_CM=10.0
HAZARD_DURATION_SEC=60.0
SETTLE_MAX_JITTER_M=0.05

# 3. Server WebSocket Broadcast
WS_HOST=0.0.0.0
WS_PORT=8765

# 4. Gateway Notifikasi WhatsApp (Fonnte API)
WA_PROVIDER=FONNTE
FONNTE_TOKEN=your_fonnte_token_here
WA_TARGET_NUMBER=62895708129090
WA_COOLDOWN_SEC=60.0
